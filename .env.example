# Sem estas variáveis o Panteão roda tudo em memória (bom para desenvolver e para os testes).
# Em produção (Vercel), as duas integrações deixam as salas sobreviverem entre funções e avisam as mesas na hora.

# Upstash Redis (pelo Marketplace da Vercel ele cria KV_REST_API_URL/KV_REST_API_TOKEN, que também valem)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ably (painel do Ably > sua app > API Keys; a chave com publish e subscribe)
ABLY_API_KEY=
